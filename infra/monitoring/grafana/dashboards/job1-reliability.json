{
  "uid": "job1-reliability",
  "title": "Job1 Reliability",
  "tags": [
    "tr1l",
    "reliability"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "실행 사건",
        "enable": true,
        "iconColor": "#F2CC0C",
        "datasource": "PostgresTarget",
        "target": {
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT occurred_at AS time, event_type || CASE WHEN detail IS NULL THEN '' ELSE ' · ' || detail END AS text, run_id AS tags FROM reliability.run_event WHERE $__timeFilter(occurred_at) AND event_type IN ('WORKER_START', 'FAULT_INJECTED', 'WORKER_EXIT', 'RERUN_START') ORDER BY 1",
          "refId": "Anno"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "실행 중 상태",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "billing_work 상태와 MongoDB snapshot 수",
      "description": "1초마다 센 값. 노란 세로선은 worker 시작, 장애 주입, 종료, 재실행 시점",
      "datasource": "PostgresTarget",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 10
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sampled_at AS time, target_count AS \"TARGET\", processing_count AS \"PROCESSING\", calculated_count AS \"CALCULATED\", failed_count AS \"FAILED\", snapshot_count AS \"Mongo snapshot\" FROM reliability.state_sample WHERE $__timeFilter(sampled_at) ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "TARGET"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PROCESSING"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CALCULATED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FAILED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mongo snapshot"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "결과만 있는 work",
      "description": "MongoDB snapshot은 있는데 CALCULATED가 아닌 work 수. 재실행이 끝나면 0이어야 한다",
      "datasource": "PostgresTarget",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT snapshot_only_count AS \"결과만 있는 work\" FROM reliability.state_sample WHERE $__timeFilter(sampled_at) ORDER BY sampled_at DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "실행 전"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "만료된 PROCESSING",
      "description": "lease_until이 지난 PROCESSING. 재실행이 끝나면 0이어야 한다 (INV-002)",
      "datasource": "PostgresTarget",
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT stale_processing AS \"만료된 PROCESSING\" FROM reliability.state_sample WHERE $__timeFilter(sampled_at) ORDER BY sampled_at DESC LIMIT 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "실행 전"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "결과만 있는 work 추이",
      "datasource": "PostgresTarget",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT sampled_at AS time, snapshot_only_count AS \"결과만 있는 work\", stale_processing AS \"만료된 PROCESSING\" FROM reliability.state_sample WHERE $__timeFilter(sampled_at) ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
