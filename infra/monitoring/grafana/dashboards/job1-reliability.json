      "targets": [
        {
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.scenario_id AS \"시나리오\", c.check_id AS \"검증\", c.detail AS \"내용\", c.violation_count AS \"위반\", CASE WHEN c.passed THEN 'PASS' ELSE 'FAIL' END AS \"결과\" FROM reliability.check_result c JOIN reliability.run r USING (run_id) ORDER BY r.started_at DESC, c.check_id LIMIT 40",
